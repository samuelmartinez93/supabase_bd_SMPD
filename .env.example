# Copia este archivo como .env.local y rellena los valores (no subas .env.local a GitHub).

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...) o la clave service_role.
# Solo se usa en el servidor: nunca la prefijes con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
